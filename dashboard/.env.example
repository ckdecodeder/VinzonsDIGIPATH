# VinzonsDIGIPATH - Frontend Dashboard Environment Variables Template
# Copy this file to '.env' and modify the values as needed.

# API base URL for the dashboard.
# Recommended for dev: /api (works on localhost, LAN devices, and dev tunnels via Vite proxy)
# Alternative direct backend URL: http://localhost:5000/api
VITE_API_BASE_URL=/api

# Timeout for API requests in milliseconds
VITE_API_TIMEOUT_MS=6000
