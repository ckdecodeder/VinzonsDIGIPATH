DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vinzons_digipath
PORT=5000
NODE_ENV=development
HOST=0.0.0.0
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Public API URL for dev tunnels / remote devices (used by /api/config auto-connect)
PUBLIC_API_URL=
# Optional extra browser origins (comma-separated). Literal IPv4/IPv6 origins are allowed in all environments.
# Example: https://digipath-zeta.vercel.app
CORS_ORIGINS=
# Set to 1 only when intentionally allowing every browser origin (staging/testing).
CORS_ALLOW_ALL=0
API_BASE_URL=http://localhost:5000/api
PUBLIC_TRACKING_BASE_URL=http://localhost:5173
# SMS stays in the outbox unless explicitly configured. For Philippines delivery,
# register the alphanumeric Sender ID with Twilio before using it as TWILIO_FROM_NUMBER.
# Set twilio_sendgrid only after registration and an approved test recipient are ready.
SENDER_NOTIFICATION_PROVIDER=outbox
# Sender delivery options:
# - outbox: queue records only
# - twilio_sendgrid: send SMS with Twilio and email with SendGrid
# - twilio_resend: send SMS with Twilio and email with Resend
# - webhook: POST sender notification payloads to SENDER_NOTIFICATION_WEBHOOK_URL
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Provider requests are capped at 10 seconds by default (allowed range: 1–30 seconds).
SENDER_NOTIFICATION_TIMEOUT_MS=10000
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Vinzons DigiPath
SENDER_NOTIFICATION_WEBHOOK_URL=
SENDER_NOTIFICATION_WEBHOOK_TOKEN=
# Generate a strong key and configure the SAME key on the physical Pi before restarting.
DEVICE_API_KEY=
# WebRTC ICE servers (JSON array). Video is peer-to-peer; WS only relays signaling.
# For dev tunnels / strict NAT add a TURN server here.
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-turn:3478","username":"u","credential":"p"}]
DEVICE_HEARTBEAT_TIMEOUT_MS=90000
# Skip MongoDB + dashboard broadcast on routine Pi heartbeats while WS is up (ms)
DEVICE_HEARTBEAT_PERSIST_MS=45000
SCANNER_COMMAND_STALE_MS=300000
SCANNER_BRIDGE_TIMEOUT_MS=4000
SCANNER_BRIDGE_PORT=8080
REPORT_TEMPLATE_PATH=
MAX_ATTACHMENTS_PER_DOCUMENT=50
MAX_ATTACHMENT_BYTES=10485760
