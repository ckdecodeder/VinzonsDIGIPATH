# VinzonsDIGIPATH - Master Environment Configuration Template
# =========================================================================
# This file contains the template configurations for all components of the system:
# 1. Backend Server (backend/.env)
# 2. Frontend Dashboard (dashboard/.env)
# 3. Raspberry Pi IoT Scanner Bridge (pi_scanner_bridge environment variables)
# =========================================================================

# -------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Create in 'backend/.env')
# -------------------------------------------------------------------------
# The PostgreSQL database connection URL
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/vinzons_digipath

# Port number for the Express server to listen on
PORT=5000

# Secret key used for signing JWT login tokens (use a strong random value in production/defense)
JWT_SECRET=digipath_local_development_secret_change_me

# JWT token expiration duration (e.g., 8 hours)
JWT_EXPIRES_IN=8h

# Allowed origins for CORS, separated by commas (defaults to localhost:5173 if empty)
# CORS_ORIGIN=http://localhost:5173,http://192.168.1.100:5173

# API key for the physical scanner device to authorize requests (must match the Pi's key)
DEVICE_API_KEY=dev-device-key-change-me

# Node environment mode ('development' or 'production')
NODE_ENV=development


# -------------------------------------------------------------------------
# 2. FRONTEND DASHBOARD CONFIGURATION (Create in 'dashboard/.env')
# -------------------------------------------------------------------------
# The base URL pointing to the Backend API
VITE_API_BASE_URL=http://localhost:5000/api

# Timeout limit for dashboard API requests (in milliseconds)
VITE_API_TIMEOUT_MS=6000


# -------------------------------------------------------------------------
# 3. RASPBERRY PI IOT SCANNER CONFIGURATION (Set in Pi OS Environment)
# -------------------------------------------------------------------------
# The backend API URL reachable from the Raspberry Pi
# (Replace 127.0.0.1 with your developer laptop's local network IP address, e.g., 192.168.1.100)
DIGIPATH_BACKEND_BASE_URL=http://127.0.0.1:5000/api

# API authentication key (MUST match the DEVICE_API_KEY set in backend/.env)
DIGIPATH_DEVICE_API_KEY=dev-device-key-change-me

# Unique ID for this scanner terminal (defaults to DEV-001)
DIGIPATH_DEVICE_ID=DEV-001

# The office ID this scanner is assigned to (defaults to OFF-001)
DIGIPATH_OFFICE_ID=OFF-001

# Custom name for the physical scanner device shown in the dashboard
DIGIPATH_DEVICE_NAME="Physical Document Scanner"

# Location where the device is situated (e.g., "Reception Area")
DIGIPATH_DEVICE_LOCATION="Reception Area"

# Port number where the live MJPEG camera stream is hosted on the Pi (default: 8080)
DIGIPATH_STREAM_PORT=8080

# Heartbeat ping interval to backend in seconds (default: 10)
DIGIPATH_HEARTBEAT_INTERVAL_SECS=10

# Camera capture backend configuration ('auto', 'picamera2', or 'opencv')
DIGIPATH_ENABLE_OPENCV_CAMERA=auto
DIGIPATH_OPENCV_CAMERA_INDEX=0
