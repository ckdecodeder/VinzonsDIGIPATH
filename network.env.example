# =============================================================================
# VinzonsDIGIPATH — single network config (edit this, then run: npm run network:sync)
# =============================================================================
# Public backend URL (no trailing slash). Use dev tunnel, Cloudflare Tunnel, or cloud deploy.
DIGIPATH_PUBLIC_BACKEND_URL=https://46hdfmgm-5000.asse.devtunnels.ms

# Must match DEVICE_API_KEY in backend/.env
DIGIPATH_DEVICE_API_KEY=dev-device-key-change-me

# Groq API key for auto-fill of subject / sender / date / document type after scan
# Get one at https://console.groq.com — then run: npm run network:sync
# DIGIPATH_GROQ_API_KEY=gsk_your_key_here

# Optional: open browser automatically when you run npm start (1=yes, 0=no)
DIGIPATH_AUTO_OPEN_BROWSER=1

# Keep 0 when using the existing public Dev Tunnel URL. Set 1 only for CLI devtunnel host.
DIGIPATH_AUTO_TUNNEL=0

# Optional Pi tunnel token — only if VS Code port 5000 cannot be set to Public.
# DIGIPATH_TUNNEL_ID=sneaky-field-krnwbhm
# DIGIPATH_DEVTUNNEL_TOKEN=

# WebSocket stream tuning (synced to backend/.env + bridge.env on npm run network:sync)
REALTIME_STREAM_MIN_INTERVAL_MS=0
REALTIME_STREAM_MAX_BUFFERED_BYTES=680000
REALTIME_STREAM_MAX_CLIENT_BUFFER_FRAMES=1
REALTIME_STREAM_MAX_PAYLOAD_BYTES=1048576
DIGIPATH_STREAM_BUFFER_FRAMES=1
DIGIPATH_STREAM_FPS=30
# EMEET SmartCam S600L native 1080p stream + capture.
DIGIPATH_STREAM_WIDTH=1920
DIGIPATH_STREAM_HEIGHT=1080
DIGIPATH_STREAM_WS_MAX_FPS=30
DIGIPATH_STREAM_ADAPTIVE_MAX_FPS=30
DIGIPATH_SCAN_WIDTH=1920
DIGIPATH_SCAN_HEIGHT=1080
DIGIPATH_SCAN_ORIENTATION=landscape
DIGIPATH_SCAN_JPEG_QUALITY=92
DIGIPATH_SCAN_ENHANCE=1
DIGIPATH_SCAN_SHARPEN=1
DIGIPATH_SCAN_BURST_FRAMES=6
DIGIPATH_STREAM_JPEG_QUALITY=92
DIGIPATH_STREAM_FAST=1
DIGIPATH_STREAM_ADAPTIVE=1
DIGIPATH_STREAM_ADAPTIVE_MIN_FPS=8
DIGIPATH_CAPTURE_MATCH_PREVIEW=1
DIGIPATH_PREVIEW_ROTATE=none
DIGIPATH_PREVIEW_WIDTH=1920
DIGIPATH_PREVIEW_HEIGHT=1080
DIGIPATH_PREVIEW_JPEG_QUALITY=68
DIGIPATH_STREAM_JPEG_MAX_BYTES=380000
DIGIPATH_STREAM_JPEG_MIN_QUALITY=68
DIGIPATH_RESTART_ON_IP_CHANGE=1
DIGIPATH_IP_RESTART_DEBOUNCE_SECS=30
