# =============================================================================
# DigiPath TB6600 + YS-27 Hall sensors (add to pi_ws_scanner.env / .env on Pi)
# =============================================================================

DIGIPATH_MECH_ENABLED=0
DIGIPATH_MECH_SIMULATE=0
DIGIPATH_MECH_OPEN_LOOP=0
DIGIPATH_DOOR_MONITOR=1

# Timing
DIGIPATH_MOTOR_SETTLE_SECS=3
DIGIPATH_SCAN_SETTLE_SECS=6
DIGIPATH_MOTOR_STEP_DELAY_US=900
DIGIPATH_MOTOR_DIR_SETTLE_MS=20

# TB6600 signal: source (+GPIO,-GND) or sink (+5V,-GPIO)
DIGIPATH_TB6600_SIGNAL_SINK=0
DIGIPATH_MOTOR_DIR_INVERT=0

# Lift direction per leg (change when hardware is finalized): up | down
DIGIPATH_LIFT_TO_CAPTURE_DIR=down
DIGIPATH_LIFT_TO_MAIN_DIR=up
DIGIPATH_LIFT_TO_LAYER_DIR=down
DIGIPATH_SORT_DEPOSIT_STEPS=400

# Safety limits (steps)
DIGIPATH_LIFT_TRAVEL_MAX_STEPS=14000
DIGIPATH_LIFT_DOWN_MAX_STEPS=14000
DIGIPATH_LIFT_UP_MAX_STEPS=14000
DIGIPATH_SORT_MAX_STEPS=10000
DIGIPATH_SORT_CHUNK_STEPS=6

# Open-loop (no hall sensors): same idea as test-motors.sh — fixed step counts on scan
DIGIPATH_MECH_OPEN_LOOP=0
DIGIPATH_OPEN_LOOP_CAPTURE_STEPS=1600
DIGIPATH_OPEN_LOOP_MAIN_STEPS=1600
DIGIPATH_OPEN_LOOP_LAYER1_STEPS=500
DIGIPATH_OPEN_LOOP_LAYER2_STEPS=1000
DIGIPATH_OPEN_LOOP_LAYER3_STEPS=1500

# --- Lift motor (NEMA #1) — TB6600 #1 ---
DIGIPATH_LIFT_PUL_BCM=17
DIGIPATH_LIFT_DIR_BCM=27
DIGIPATH_LIFT_ENA_BCM=22
DIGIPATH_LIFT_DOWN_DIR_HIGH=1

# --- Sort motor (NEMA #2) — TB6600 #2 ---
DIGIPATH_SORT_PUL_BCM=23
DIGIPATH_SORT_DIR_BCM=24
DIGIPATH_SORT_ENA_BCM=25

# --- YS-27 Hall modules (5 sensors — Vinzons wiring) ---
# door=5  main+layer1=6  capture=13  layer2=19  layer3=12
DIGIPATH_HALL_DOOR_BCM=5
DIGIPATH_HALL_MAIN_BCM=6
DIGIPATH_HALL_CAPTURE_BCM=13
DIGIPATH_HALL_LAYER1_BCM=6
DIGIPATH_HALL_LAYER2_BCM=19
DIGIPATH_HALL_LAYER3_BCM=12
DIGIPATH_HALL_ACTIVE_LOW=1
# Only if layer3 hall is disabled (DIGIPATH_HALL_LAYER3_BCM=0):
DIGIPATH_HALL_LAYER3_EXTRA_STEPS=500

# Flow:
#   door closed (hall 1) -> lift to capture (hall 3) -> scan/upload
#   -> sort to layer (hall 4/5/6) -> lift to main (hall 2)
#
# Sort layers:
#   1 = Memorandum (DT-001)
#   2 = Executive Order (DT-002)
#   3 = Communication Letter (DT-003)
