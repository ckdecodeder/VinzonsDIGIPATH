# Copy this file to bridge.env (same folder as pi_scanner_bridge.py).
# Edit once — no terminal export needed. Works from Geany or python3.

# Laptop backend on same WiFi/hotspot (ipconfig on Windows):
DIGIPATH_BACKEND_BASE_URL=http://10.137.17.129:5000/api

# Dashboard bridge URL (Pi IP, not backend): http://10.137.17.39:8080

# Or dev tunnel if Pi cannot reach laptop LAN IP:
# DIGIPATH_BACKEND_BASE_URL=https://46hdfmgm-5000.asse.devtunnels.ms/api

# Must match DEVICE_API_KEY in backend/.env on the laptop:
DIGIPATH_DEVICE_API_KEY=dev-device-key-change-me

DIGIPATH_DEVICE_ID=DEV-001
DIGIPATH_OFFICE_ID=OFF-001
DIGIPATH_STREAM_PORT=8080
DIGIPATH_STREAM_FPS=20
DIGIPATH_STREAM_WIDTH=960
DIGIPATH_STREAM_HEIGHT=540
DIGIPATH_STREAM_JPEG_QUALITY=78
DIGIPATH_HEARTBEAT_INTERVAL_SECS=10
DIGIPATH_USE_WEBSOCKET=1
DIGIPATH_AUTO_INSTALL=1
DIGIPATH_DEVICE_NAME=Physical Document Scanner
DIGIPATH_DEVICE_LOCATION=Reception Area
