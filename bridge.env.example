# Copy this file to bridge.env (same folder as pi_scanner_bridge.py).
# Prefer: edit network.env on laptop and run  npm run network:sync

# Public backend URL (Pi reaches this from any WiFi):
DIGIPATH_BACKEND_BASE_URL=https://46hdfmgm-5000.asse.devtunnels.ms/api

# Must match DEVICE_API_KEY in backend/.env on the laptop:
DIGIPATH_DEVICE_API_KEY=dev-device-key-change-me

DIGIPATH_DEVICE_ID=DEV-001
DIGIPATH_OFFICE_ID=OFF-001

# ---- Groq AI document extraction (optional but recommended) ----
# Get a free key at https://console.groq.com/keys . Leave blank to use OCR only.
DIGIPATH_GROQ_API_KEY=
DIGIPATH_AI_EXTRACT=1
DIGIPATH_AI_USE_VISION=1
# Run AI extraction AFTER upload so the dashboard proceeds instantly, then the
# document fields fill in a few seconds later. Set 0 to wait for AI before upload.
DIGIPATH_AI_BACKGROUND=1
DIGIPATH_GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
DIGIPATH_GROQ_TEXT_MODEL=llama-3.3-70b-versatile

DIGIPATH_STREAM_PORT=8080
DIGIPATH_STREAM_FPS=30
DIGIPATH_STREAM_WIDTH=640
DIGIPATH_STREAM_HEIGHT=360
DIGIPATH_STREAM_JPEG_QUALITY=82
DIGIPATH_STREAM_FAST=0
# Cap WebSocket frame push rate (0 = no cap). Prevents dev-tunnel buffer
# overflow that makes the preview suddenly go black.
DIGIPATH_STREAM_WS_MAX_FPS=24
DIGIPATH_STREAM_COLOR_MODE=jpeg
DIGIPATH_CAMERA_AWB=auto
# USB webcam support (OpenCV). auto = use USB ONLY when the Pi CSI camera is
# missing. With the CSI camera plugged in, this stays off automatically.
# Set to 1 to FORCE a USB webcam even if a CSI camera exists.
DIGIPATH_ENABLE_OPENCV_CAMERA=auto
# USB webcam device index — leave commented for auto-detect (0-5).
# Uncomment and set only if you FORCE a USB webcam on a specific /dev/videoN.
# DIGIPATH_OPENCV_CAMERA_INDEX=0
# Instant capture: grab the still from the live preview the moment Capture is
# pressed (no slow camera re-open/warmup). Set 0 for a fresh high-res grab.
DIGIPATH_INSTANT_CAPTURE=1
# USB webcam capture resolution — read high-res for OCR, preview is downscaled.
# Lower these (e.g. 1280x720) if the Pi 3B stream stutters.
DIGIPATH_USB_CAPTURE_WIDTH=1920
DIGIPATH_USB_CAPTURE_HEIGHT=1080
# Capture the SAME view as the live preview (no auto-crop, matched aspect ratio).
DIGIPATH_AUTO_CROP=0
DIGIPATH_CAPTURE_MATCH_PREVIEW=1
# Upload JPG for preview/OCR (recommended). Set 1 to also save a PDF copy.
DIGIPATH_SAVE_PDF=0
DIGIPATH_HEARTBEAT_INTERVAL_SECS=10
DIGIPATH_RESTART_ON_IP_CHANGE=1
DIGIPATH_IP_RESTART_DEBOUNCE_SECS=30
DIGIPATH_USE_WEBSOCKET=1
DIGIPATH_ENABLE_MJPEG_HTTP=1
DIGIPATH_AUTO_INSTALL=1
DIGIPATH_DEVICE_NAME=Physical Document Scanner
DIGIPATH_DEVICE_LOCATION=Reception Area

# 2x TB6600 + 3-layer sorting — triggered on Capture/SCAN
DIGIPATH_MOTOR_ENABLED=1
DIGIPATH_MOTOR_DRIVER=tb6600-dual
# Higher = slower step rate (smooth). 3500us ~= gentle slow motion (sort).
DIGIPATH_MOTOR_STEP_DELAY_US=3500
# Lift up/down positioning runs FASTER so Capture proceeds quickly (lower=faster).
DIGIPATH_LIFT_STEP_DELAY_US=900
DIGIPATH_MOTOR_ENA_ACTIVE_LOW=1
DIGIPATH_LAYER_COUNT=3
DIGIPATH_SORT_RULE=priority
DIGIPATH_LAYER_SETTLE_MS=300

# TB6600 #1 — LIFT motor (scan height + 3 layers)
DIGIPATH_LIFT_PUL_GPIO=17
DIGIPATH_LIFT_DIR_GPIO=18
# ENA disabled (0) — driver stays enabled; no ENA+/ENA- wiring needed.
DIGIPATH_LIFT_ENA_GPIO=0
DIGIPATH_LIFT_UP_DIR=1
DIGIPATH_LIFT_HOME_STEPS=0
# Home is at TOP. SCAN/DEPOSIT = steps DOWN from top.
DIGIPATH_LIFT_SCAN_STEPS=1600
DIGIPATH_LIFT_DEPOSIT_STEPS=1600
DIGIPATH_LAYER1_STEPS=500
DIGIPATH_LAYER2_STEPS=1000
DIGIPATH_LAYER3_STEPS=1500
DIGIPATH_SORT_LAYER_URGENT=1
DIGIPATH_SORT_LAYER_HIGH=2
DIGIPATH_SORT_LAYER_NORMAL=3
DIGIPATH_SORT_LAYER_LOW=3

# TB6600 #2 — ROTATE motor (LEFT only)
DIGIPATH_ROTATE_PUL_GPIO=27
DIGIPATH_ROTATE_DIR_GPIO=23
DIGIPATH_ROTATE_ENA_GPIO=0
DIGIPATH_ROTATE_LEFT_STEPS=1200
DIGIPATH_ROTATE_LEFT_DIR=0
# Sorting selector: rotate to a bin per layer, then rotate back (1=return).
DIGIPATH_ROTATE_SORT_DIR=0
DIGIPATH_ROTATE_RETURN=1
DIGIPATH_ROTATE_LAYER1_STEPS=400
DIGIPATH_ROTATE_LAYER2_STEPS=800
DIGIPATH_ROTATE_LAYER3_STEPS=1200
DIGIPATH_SORT_DROP_MS=400
