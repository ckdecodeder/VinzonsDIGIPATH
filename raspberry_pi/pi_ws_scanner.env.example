# DigiPath Pi package — copy this folder to the Pi Desktop as VinzonsDIGIPATH-Pi
# ============================================================================
#   USB stick / scp  →  ~/Desktop/VinzonsDIGIPATH-Pi
#
# FIRST TIME (once):
#   cd ~/Desktop/VinzonsDIGIPATH-Pi
#   cp pi_ws_scanner.env.example .env
#   nano .env          # set BACKEND URL + DEVICE API KEY
#   bash fix-pi-scripts.sh
#   sudo bash scripts/pi-install-all.sh
#
# AFTER THAT: just power on / reboot — digipath-ws-scanner starts alone.
#
# IMPORTANT — internet vs hotspot:
#   DIGIPATH_WIFI_FORCE_HOTSPOT=0   (keep this so office WiFi stays up)
#   (1 = DigiPath-Setup hotspot steals wlan0 and heartbeats cannot reach the server)
#
# Verify backend from Pi:
#   curl -sS https://YOUR_TUNNEL_OR_SERVER/api/status
#   journalctl -u digipath-ws-scanner -n 50 --no-pager
#
# Useful:
#   sudo systemctl status digipath-ws-scanner --no-pager
#   sudo systemctl restart digipath-ws-scanner
#   bash scripts/ws.sh

DIGIPATH_BACKEND_BASE_URL=https://46hdfmgm-5000.asse.devtunnels.ms/api
DIGIPATH_DEVICE_API_KEY=dev-device-key-change-me
DIGIPATH_DEVICE_ID=DEV-001
DIGIPATH_OFFICE_ID=OFF-001

# Skip apt/pip on every boot once deps are installed
DIGIPATH_AUTO_INSTALL=0

# Required for Microsoft dev tunnel when Pi is on another network (remote client).
# DIGIPATH_DEVTUNNEL_TOKEN=
# DIGIPATH_WS_AUTH_TIMEOUT_SECS=20

# Text extraction (optional)
DIGIPATH_GROQ_API_KEY=your-groq-api-key-here
DIGIPATH_GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
DIGIPATH_GROQ_TEXT_MODEL=llama-3.3-70b-versatile
DIGIPATH_AI_EXTRACT=1
DIGIPATH_AI_USE_VISION=1
DIGIPATH_AI_BACKGROUND=1
DIGIPATH_AI_EXTRACT_MAX_TOKENS=4096

# Camera / stream
DIGIPATH_CAMERA_INDEX=0
DIGIPATH_CAMERA_SCAN_MAX=2
DIGIPATH_USE_PICAMERA2=0
DIGIPATH_CAMERA_AUTOFOCUS=1
DIGIPATH_FOCUS_TRIGGER_ON_CAPTURE=1
DIGIPATH_FOCUS_SETTLE_SECS=0.8
DIGIPATH_CAMERA_WARMUP_SECS=1
DIGIPATH_SCAN_WARMUP_FRAMES=15
DIGIPATH_STREAM_WIDTH=2560
DIGIPATH_STREAM_HEIGHT=1440
DIGIPATH_SCAN_WIDTH=1920
DIGIPATH_SCAN_HEIGHT=1080
DIGIPATH_SCAN_ORIENTATION=landscape
DIGIPATH_SCAN_JPEG_QUALITY=98
DIGIPATH_SCAN_ENHANCE=1
DIGIPATH_SCAN_SHARPEN=1
DIGIPATH_SCAN_BURST_FRAMES=6
DIGIPATH_STREAM_JPEG_QUALITY=92
DIGIPATH_STREAM_FAST=1
DIGIPATH_STREAM_WS_MAX_FPS=15
DIGIPATH_STREAM_ADAPTIVE=1
DIGIPATH_STREAM_ADAPTIVE_MIN_FPS=8
DIGIPATH_STREAM_ADAPTIVE_MAX_FPS=25
DIGIPATH_CAPTURE_MATCH_PREVIEW=1
DIGIPATH_PREVIEW_ROTATE=none
DIGIPATH_PREVIEW_WIDTH=1920
DIGIPATH_PREVIEW_HEIGHT=1080
DIGIPATH_PREVIEW_JPEG_QUALITY=68
DIGIPATH_STREAM_JPEG_MAX_BYTES=380000
DIGIPATH_STREAM_JPEG_MIN_QUALITY=68
DIGIPATH_STREAM_BUFFER_FRAMES=1
DIGIPATH_STREAM_DRIVER_DRAIN=1
DIGIPATH_CAMERA_READ_TIMEOUT_MS=10000
DIGIPATH_CAMERA_READ_RETRIES=4
DIGIPATH_CAMERA_RECOVER_AFTER_MISSES=24
DIGIPATH_CAMERA_REOPEN_AFTER_MISSES=120
DIGIPATH_HEARTBEAT_INTERVAL_SECS=5

# Mechanism (TB6600)
DIGIPATH_MECH_ENABLED=1
DIGIPATH_MECH_OPEN_LOOP=1
DIGIPATH_MECH_HOME_ON_START=0
DIGIPATH_DOOR_MONITOR=0
DIGIPATH_MECH_SORT_AFTER_UPLOAD=1
DIGIPATH_MECH_SIMULATE=0
DIGIPATH_MOVE_STEPS=900
DIGIPATH_CAPTURE_DOWN_COUNT=3
DIGIPATH_SORT_DEPOSIT_STEPS=900
DIGIPATH_MOTOR_SETTLE_SECS=2
DIGIPATH_SCAN_SETTLE_SECS=2
DIGIPATH_LIFT_PUL_BCM=17
DIGIPATH_LIFT_DIR_BCM=27
DIGIPATH_LIFT_ENA_BCM=22
DIGIPATH_SORT_PUL_BCM=23
DIGIPATH_SORT_DIR_BCM=24
DIGIPATH_SORT_ENA_BCM=25

# WiFi — keep FORCE_HOTSPOT=0 so scanner can reach the internet/tunnel
DIGIPATH_WIFI_PROVISION=1
DIGIPATH_WIFI_FORCE_HOTSPOT=0
DIGIPATH_WIFI_HOTSPOT_SSID=DigiPath-Setup
DIGIPATH_WIFI_HOTSPOT_PASSWORD=
DIGIPATH_WIFI_PROVISION_PORT=80

# Sort layers
DIGIPATH_SORT_RULE=document_type
DIGIPATH_SORT_DOCUMENT_TYPE_LAYERS={"DT-001":1,"DT-002":2,"DT-003":3}
DIGIPATH_STREAM_FPS=20
DIGIPATH_STREAM_HTTP_UPLOAD=auto
DIGIPATH_WS_PING_INTERVAL=0
DIGIPATH_WS_STALE_SECS=90
